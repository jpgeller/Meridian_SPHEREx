# Copy to api/.env (git-ignored) and fill in. Never commit the real key or send it to the browser.
# Load it with: ./.venv/bin/python -m uvicorn main:app --env-file .env ...
ANTHROPIC_API_KEY=
# Optional: the model the AI guide (POST /api/guide, /api/guide/nudge) uses. Default: claude-haiku-5-5 (small and fast).
# GUIDE_MODEL=claude-haiku-5-5
# Optional: at most this many model calls per UTC day (all guide endpoints). Default: 400.
# Today's calls and tokens: GET /api/guide/usage
# GUIDE_DAILY_MAX=400

# Artist's-impressions bake-off (tools/impressions_bakeoff.py, docs/AI_IMAGES_PLAN.md A1). Offline tool only:
# these keys are never used by the running API or sent to the browser. Leave out the providers you skip.
GEMINI_API_KEY=
OPENAI_API_KEY=
BFL_API_KEY=
# Optional model overrides (defaults: gemini-nano-banana-2.1, gpt-image-2, flux-3-image)
# GEMINI_IMAGE_MODEL=
# OPENAI_IMAGE_MODEL=
# BFL_MODEL=
