# Copy to api/.env (git-ignored) and fill in. Never commit the real key or send it to the browser.
# Load it with: ./.venv/bin/python -m uvicorn main:app --env-file .env ...
ANTHROPIC_API_KEY=
# Optional: the model the AI guide (POST /api/guide) uses. Default: claude-haiku-5-5 (small and fast).
